#!/bin/sh
set -e

# Stop a running daemon, including one started manually without enabling it.
# The unit itself is not disabled here; package removal deletes it afterwards.
if command -v systemctl >/dev/null 2>&1; then
    if systemctl is-active --quiet aevand.service 2>/dev/null; then
        systemctl stop aevand.service
    fi
fi

exit 0
